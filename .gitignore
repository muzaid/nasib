# Generated at deploy time from the Vercel environment variables. It holds
# the project URL and the anon key — both public by design — but it is
# still generated rather than committed, so there is one place the values
# come from and no stale copy to wonder about.
apps/web/config.js

# The dev server's self-signed certificate. Machine-specific and worthless
# anywhere else.
apps/web/.dev-cert.pem

# Never. The service-role key bypasses every row-level security policy in
# supabase/migrations; a copy of it in a repository is the whole database.
.env
.env.*
!.env.example

node_modules/
.vercel/

# Flutter. The `android/` directory is generated by `flutter create` and
# then patched by tool/patch_android.py, in CI and on a laptop alike, so
# that the Gradle files always match the pinned Flutter version rather
# than a version someone had installed a year ago.
apps/mobile/.dart_tool/
apps/mobile/build/
apps/mobile/android/
apps/mobile/.flutter-plugins*
apps/mobile/pubspec.lock
*.apk
*.aab
local.properties
.gradle/

# Note what is NOT ignored: apps/mobile/ios/Runner/*.swift is written by
# hand — ScreenGuard is the screenshot blocking — and a blanket ios/ rule
# would silently drop it. Everything else under ios/ is generated, and
# `flutter create` puts these files back where it expects them.
apps/mobile/ios/Flutter/
apps/mobile/ios/Pods/
apps/mobile/ios/Runner.xcworkspace/
apps/mobile/ios/*.xcodeproj/

__pycache__/
*.pyc
.DS_Store
